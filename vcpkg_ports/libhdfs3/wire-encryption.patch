+#include "DigestMd5.h"
+
+#include "Exception.h"
+#include "ExceptionInternal.h"
+
+#include <openssl/hmac.h>
+#include <openssl/md5.h>
+#include <openssl/rand.h>
+
+#include <map>
+#include <vector>
+
+namespace Hdfs {
+namespace Internal {
+
+namespace {
+
+std::string Md5(const std::string & data) {
+    unsigned char out[EVP_MAX_MD_SIZE];
+    unsigned int len = 0;
+
+    if (EVP_Digest(data.data(), data.size(), out, &len, EVP_md5(), NULL) != 1) {
+        THROW(HdfsIOException, "DIGEST-MD5: MD5 failed");
+    }
+
+    return std::string(reinterpret_cast<char *>(out), len);
+}
+
+std::string Hex(const std::string & data) {
+    static const char * digits = "0123456789abcdef";
+    std::string out;
+
+    for (size_t i = 0; i < data.size(); ++i) {
+        unsigned char c = static_cast<unsigned char>(data[i]);
+        out += digits[c >> 4];
+        out += digits[c & 15];
+    }
+
+    return out;
+}
+
+std::string HmacMd5(const std::string & key, const std::string & data) {
+    unsigned char out[EVP_MAX_MD_SIZE];
+    unsigned int len = 0;
+
+    if (!HMAC(EVP_md5(), key.data(), static_cast<int>(key.size()),
+              reinterpret_cast<const unsigned char *>(data.data()), data.size(), out, &len)) {
+        THROW(HdfsIOException, "DIGEST-MD5: HMAC-MD5 failed");
+    }
+
+    return std::string(reinterpret_cast<char *>(out), len);
+}
+
+std::string Base64(const std::string & data) {
+    std::vector<unsigned char> out(4 * ((data.size() + 2) / 3) + 1);
+    int len = EVP_EncodeBlock(out.data(), reinterpret_cast<const unsigned char *>(data.data()),
+                              static_cast<int>(data.size()));
+    return std::string(reinterpret_cast<char *>(out.data()), len);
+}
+
+// Parse a DIGEST-MD5 challenge: comma-separated key=value pairs whose values
+// may be quoted (with \-escapes).
+std::map<std::string, std::string> ParseChallenge(const std::string & text) {
+    std::map<std::string, std::string> out;
+    size_t i = 0;
+
+    while (i < text.size()) {
+        while (i < text.size() && (text[i] == ',' || text[i] == ' ')) {
+            ++i;
+        }
+
+        size_t eq = text.find('=', i);
+
+        if (eq == std::string::npos) {
+            break;
+        }
+
+        std::string key = text.substr(i, eq - i);
+        std::string value;
+        i = eq + 1;
+
+        if (i < text.size() && text[i] == '"') {
+            ++i;
+
+            while (i < text.size() && text[i] != '"') {
+                if (text[i] == '\\' && i + 1 < text.size()) {
+                    ++i;
+                }
+
+                value += text[i++];
+            }
+
+            ++i; // closing quote
+        } else {
+            size_t comma = text.find(',', i);
+            value = text.substr(i, comma == std::string::npos ? std::string::npos : comma - i);
+            i = comma == std::string::npos ? text.size() : comma;
+        }
+
+        out[key] = value;
+    }
+
+    return out;
+}
+
+bool ListContains(const std::string & list, const std::string & item) {
+    size_t start = 0;
+
+    while (start <= list.size()) {
+        size_t comma = list.find(',', start);
+        std::string entry = list.substr(start, comma == std::string::npos ? std::string::npos : comma - start);
+
+        if (entry == item) {
+            return true;
+        }
+
+        if (comma == std::string::npos) {
+            break;
+        }
+
+        start = comma + 1;
+    }
+
+    return false;
+}
+
+const char * QopName(int qop) {
+    return qop == DigestMd5Client::QOP_AUTH_CONF ? "auth-conf"
+           : qop == DigestMd5Client::QOP_AUTH_INT ? "auth-int" : "auth";
+}
+
+// Expand 14 bytes of key into two 8-byte DES keys with odd parity (RFC 2831).
+std::string DesKey(const std::string & key) {
+    std::string out;
+
+    for (size_t half = 0; half < 2; ++half) {
+        uint64_t bits = 0;
+
+        for (size_t j = 0; j < 7; ++j) {
+            bits = (bits << 8) | static_cast<unsigned char>(key[half * 7 + j]);
+        }
+
+        bits <<= 8;
+
+        for (int i = 0; i < 8; ++i) {
+            unsigned char byte = static_cast<unsigned char>(bits >> ((8 - i) * 7)) & 0xFE;
+            int ones = 0;
+
+            for (int b = 1; b < 8; ++b) {
+                ones += (byte >> b) & 1;
+            }
+
+            if (ones % 2 == 0) {
+                byte |= 0x01; // odd parity
+            }
+
+            out += static_cast<char>(byte);
+        }
+    }
+
+    return out;
+}
+
+EVP_CIPHER_CTX * NewTripleDes(const std::string & sealingKey, bool encrypt) {
+    std::string key = DesKey(sealingKey.substr(0, 14));
+    std::string iv = sealingKey.substr(8, 8);
+    EVP_CIPHER_CTX * ctx = EVP_CIPHER_CTX_new();
+
+    if (!ctx || EVP_CipherInit_ex(ctx, EVP_des_ede_cbc(), NULL,
+                                  reinterpret_cast<const unsigned char *>(key.data()),
+                                  reinterpret_cast<const unsigned char *>(iv.data()), encrypt ? 1 : 0) != 1) {
+        EVP_CIPHER_CTX_free(ctx);
+        THROW(HdfsIOException, "DIGEST-MD5: cannot initialize 3DES");
+    }
+
+    EVP_CIPHER_CTX_set_padding(ctx, 0);
+    return ctx;
+}
+
+std::string RunCipher(EVP_CIPHER_CTX * ctx, const std::string & in) {
+    std::string out(in.size() + 16, '\0');
+    int len = 0;
+
+    if (EVP_CipherUpdate(ctx, reinterpret_cast<unsigned char *>(&out[0]), &len,
+                         reinterpret_cast<const unsigned char *>(in.data()), static_cast<int>(in.size())) != 1) {
+        THROW(HdfsIOException, "DIGEST-MD5: 3DES failed");
+    }
+
+    out.resize(len);
+    return out;
+}
+
+std::string BigEndian32(uint32_t v) {
+    std::string out(4, '\0');
+    out[0] = static_cast<char>(v >> 24);
+    out[1] = static_cast<char>(v >> 16);
+    out[2] = static_cast<char>(v >> 8);
+    out[3] = static_cast<char>(v);
+    return out;
+}
+
+}
+
+DigestMd5Client::DigestMd5Client(const std::string & username, const std::string & password,
+                                 const std::string & digestUri) :
+    username(username), password(password), digestUri(digestUri), qop(QOP_AUTH), done(false),
+    encryptor(NULL), decryptor(NULL), sendSeq(0), recvSeq(0) {
+}
+
+DigestMd5Client::~DigestMd5Client() {
+    EVP_CIPHER_CTX_free(encryptor);
+    EVP_CIPHER_CTX_free(decryptor);
+}
+
+std::string DigestMd5Client::a1() const {
+    return Md5(username + ":" + realm + ":" + password) + ":" + nonce + ":" + cnonce;
+}
+
+std::string DigestMd5Client::computeResponse(bool initial) const {
+    std::string a2 = std::string(initial ? "AUTHENTICATE:" : ":") + digestUri;
+
+    if (qop != QOP_AUTH) {
+        a2 += ":00000000000000000000000000000000";
+    }
+
+    return Hex(Md5(Hex(Md5(a1())) + ":" + nonce + ":00000001:" + cnonce + ":" + QopName(qop) + ":" +
+                   Hex(Md5(a2))));
+}
+
+std::string DigestMd5Client::respond(const std::string & challenge, int allowedQops) {
+    std::map<std::string, std::string> fields = ParseChallenge(challenge);
+    realm = fields["realm"];
+    nonce = fields["nonce"];
+
+    if (nonce.empty()) {
+        THROW(HdfsIOException, "DIGEST-MD5: the DataNode's challenge has no nonce");
+    }
+
+    std::string offered = fields.count("qop") ? fields["qop"] : "auth";
+    int offeredQops = (ListContains(offered, "auth") ? QOP_AUTH : 0)
+                      | (ListContains(offered, "auth-int") ? QOP_AUTH_INT : 0)
+                      | (ListContains(offered, "auth-conf") ? QOP_AUTH_CONF : 0);
+    int usable = offeredQops & allowedQops;
+
+    if (usable & QOP_AUTH_CONF) {
+        qop = QOP_AUTH_CONF;
+    } else if (usable & QOP_AUTH_INT) {
+        qop = QOP_AUTH_INT;
+    } else if (usable & QOP_AUTH) {
+        qop = QOP_AUTH;
+    } else {
+        THROW(HdfsIOException, "DIGEST-MD5: the DataNode offers protection \"%s\", which dfs.data.transfer.protection "
+              "doesn't allow", offered.c_str());
+    }
+
+    if (qop == QOP_AUTH_CONF && !ListContains(fields["cipher"], "3des")) {
+        THROW(HdfsIOException, "DIGEST-MD5: the DataNode offers ciphers \"%s\"; only 3des is supported",
+              fields["cipher"].c_str());
+    }
+
+    unsigned char random[12];
+
+    if (RAND_bytes(random, sizeof(random)) != 1) {
+        THROW(HdfsIOException, "DIGEST-MD5: cannot generate a client nonce");
+    }
+
+    cnonce = Base64(std::string(reinterpret_cast<char *>(random), sizeof(random)));
+    std::string response = "username=\"" + username + "\",realm=\"" + realm + "\",nonce=\"" + nonce +
+                           "\",cnonce=\"" + cnonce + "\",nc=00000001,qop=" + QopName(qop) + ",digest-uri=\"" +
+                           digestUri + "\",response=" + computeResponse(true) + ",charset=utf-8";
+
+    if (qop == QOP_AUTH_CONF) {
+        response += ",cipher=\"3des\"";
+    }
+
+    return response;
+}
+
+void DigestMd5Client::complete(const std::string & serverFinal) {
+    std::map<std::string, std::string> fields = ParseChallenge(serverFinal);
+
+    if (fields["rspauth"] != computeResponse(false)) {
+        THROW(AccessControlException, "DIGEST-MD5: the DataNode's response did not authenticate it");
+    }
+
+    std::string ha1 = Md5(a1());
+    kic = Md5(ha1 + "Digest session key to client-to-server signing key magic constant");
+    kis = Md5(ha1 + "Digest session key to server-to-client signing key magic constant");
+
+    if (qop == QOP_AUTH_CONF) {
+        encryptor = NewTripleDes(Md5(ha1 + "Digest H(A1) to client-to-server sealing key magic constant"), true);
+        decryptor = NewTripleDes(Md5(ha1 + "Digest H(A1) to server-to-client sealing key magic constant"), false);
+    }
+
+    done = true;
+}
+
+std::string DigestMd5Client::wrap(const std::string & data) {
+    if (!hasSecurityLayer()) {
+        THROW(HdfsIOException, "DIGEST-MD5: no security layer to wrap with");
+    }
+
+    std::string seq = BigEndian32(sendSeq++);
+    std::string mac = HmacMd5(kic, seq + data).substr(0, 10);
+    std::string out;
+
+    if (encryptor) {
+        size_t padding = 8 - (data.size() + 10) % 8;
+        out = RunCipher(encryptor, data + std::string(padding, static_cast<char>(padding)) + mac);
+    } else {
+        out = data + mac;
+    }
+
+    out += std::string("\x00\x01", 2);
+    out += seq;
+    return out;
+}
+
+std::string DigestMd5Client::unwrap(const std::string & data) {
+    if (!hasSecurityLayer()) {
+        THROW(HdfsIOException, "DIGEST-MD5: no security layer to unwrap with");
+    }
+
+    if (data.size() < 16 || data[data.size() - 6] != 0 || data[data.size() - 5] != 1) {
+        THROW(HdfsIOException, "DIGEST-MD5: malformed wrapped message");
+    }
+
+    std::string seq = data.substr(data.size() - 4);
+    std::string body = data.substr(0, data.size() - 6);
+    std::string message;
+    std::string mac;
+
+    if (decryptor) {
+        if (body.size() % 8 != 0) {
+            THROW(HdfsIOException, "DIGEST-MD5: malformed encrypted message");
+        }
+
+        std::string plain = RunCipher(decryptor, body);
+        mac = plain.substr(plain.size() - 10);
+        plain.resize(plain.size() - 10);
+        size_t padding = plain.empty() ? 0 : static_cast<unsigned char>(plain[plain.size() - 1]);
+
+        if (padding < 1 || padding > 8 || padding > plain.size()) {
+            THROW(HdfsIOException, "DIGEST-MD5: bad padding in encrypted message");
+        }
+
+        message = plain.substr(0, plain.size() - padding);
+    } else {
+        mac = body.substr(body.size() - 10);
+        message = body.substr(0, body.size() - 10);
+    }
+
+    if (HmacMd5(kis, seq + message).substr(0, 10) != mac) {
+        THROW(HdfsIOException, "DIGEST-MD5: integrity check failed on a message from the DataNode");
+    }
+
+    recvSeq++;
+    return message;
+}
+
+}
+}
