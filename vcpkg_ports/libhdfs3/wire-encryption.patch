+#include "WrappedSocket.h"
+
+#include "DateTime.h"
+#include "Exception.h"
+#include "ExceptionInternal.h"
+
+#include <algorithm>
+#include <cstring>
+
+namespace Hdfs {
+namespace Internal {
+
+WrappedSocket::WrappedSocket(shared_ptr<Socket> inner) :
+    inner(inner), offset(0) {
+}
+
+int32_t WrappedSocket::read(char * buffer, int32_t size) {
+    if (offset >= plain.size()) {
+        plain.clear();
+        offset = 0;
+        fill(-1);
+    }
+
+    int32_t n = static_cast<int32_t>(std::min<size_t>(size, plain.size() - offset));
+    memcpy(buffer, plain.data() + offset, n);
+    offset += n;
+    return n;
+}
+
+void WrappedSocket::readFully(char * buffer, int32_t size, int timeout) {
+    int32_t done = 0;
+    int deadline = timeout;
+
+    while (done < size) {
+        if (offset >= plain.size()) {
+            steady_clock::time_point s = steady_clock::now();
+            plain.clear();
+            offset = 0;
+            fill(deadline);
+
+            if (timeout > 0) {
+                deadline -= ToMilliSeconds(s, steady_clock::now());
+
+                if (deadline <= 0 && offset >= plain.size()) {
+                    THROW(HdfsTimeoutException, "Read %d bytes timeout", size);
+                }
+            }
+        }
+
+        int32_t n = static_cast<int32_t>(std::min<size_t>(size - done, plain.size() - offset));
+        memcpy(buffer + done, plain.data() + offset, n);
+        offset += n;
+        done += n;
+    }
+}
+
+int32_t WrappedSocket::write(const char * buffer, int32_t size) {
+    send(buffer, size, -1);
+    return size;
+}
+
+void WrappedSocket::writeFully(const char * buffer, int32_t size, int timeout) {
+    send(buffer, size, timeout);
+}
+
+void WrappedSocket::connect(const char * host, int port, int timeout) {
+    THROW(HdfsIOException, "WrappedSocket: cannot reconnect a protected connection");
+}
+
+void WrappedSocket::connect(const char * host, const char * port, int timeout) {
+    THROW(HdfsIOException, "WrappedSocket: cannot reconnect a protected connection");
+}
+
+void WrappedSocket::connect(struct addrinfo * paddr, const char * host, const char * port, int timeout) {
+    THROW(HdfsIOException, "WrappedSocket: cannot reconnect a protected connection");
+}
+
+bool WrappedSocket::poll(bool read, bool write, int timeout) {
+    if (read && offset < plain.size()) {
+        return true;
+    }
+
+    return inner->poll(read, write, timeout);
+}
+
+void WrappedSocket::setBlockMode(bool enable) {
+    inner->setBlockMode(enable);
+}
+
+void WrappedSocket::setNoDelay(bool enable) {
+    inner->setNoDelay(enable);
+}
+
+void WrappedSocket::setLingerTimeout(int timeout) {
+    inner->setLingerTimeout(timeout);
+}
+
+void WrappedSocket::disableSigPipe() {
+    inner->disableSigPipe();
+}
+
+void WrappedSocket::close() {
+    plain.clear();
+    offset = 0;
+    inner->close();
+}
+
+}
+}
