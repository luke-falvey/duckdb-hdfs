+// Map Hadoop's protection names to GNU SASL's QOP names.
+static std::string ToGsaslQops(const std::string & protection) {
+    std::string qops;
+    std::string::size_type start = 0;
+
+    while (start <= protection.size()) {
+        std::string::size_type comma = protection.find(',', start);
+        std::string item = protection.substr(start, comma == std::string::npos ? std::string::npos : comma - start);
+        item.erase(0, item.find_first_not_of(" \t"));
+        item.erase(item.find_last_not_of(" \t") + 1);
+        const char * qop = NULL;
+
+        if (item == "authentication") {
+            qop = "qop-auth";
+        } else if (item == "integrity") {
+            qop = "qop-int";
+        } else if (item == "privacy") {
+            qop = "qop-conf";
+        } else if (!item.empty()) {
+            THROW(HdfsConfigInvalid, "Invalid hadoop.rpc.protection value \"%s\"", item.c_str());
+        }
+
+        if (qop) {
+            qops += qops.empty() ? qop : std::string(",") + qop;
+        }
+
+        if (comma == std::string::npos) {
+            break;
+        }
+
+        start = comma + 1;
+    }
+
+    return qops;
+}
