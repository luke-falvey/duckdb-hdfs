+bool FileSystemImpl::getDataEncryptionKey(DataEncryptionKey & key) {
+    if (!nn) {
+        THROW(HdfsIOException, "FileSystemImpl: not connected.");
+    }
+
+    lock_guard<mutex> lock(mutDataEncryptionKey);
+    int64_t now = std::chrono::duration_cast<std::chrono::milliseconds>(
+                      std::chrono::system_clock::now().time_since_epoch()).count();
+
+    // Refetch ten minutes before expiry, as the Hadoop client does.
+    if (!haveDataEncryptionKey || dataEncryptionKey.expiryDate - 10 * 60 * 1000 < now) {
+        haveDataEncryptionKey = nn->getDataEncryptionKey(dataEncryptionKey);
+    }
+
+    if (haveDataEncryptionKey) {
+        key = dataEncryptionKey;
+    }
+
+    return haveDataEncryptionKey;
+}
