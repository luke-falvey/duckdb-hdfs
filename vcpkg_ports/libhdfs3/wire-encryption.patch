+#ifndef _HDFS_LIBHDFS3_CLIENT_DIGESTMD5_H_
+#define _HDFS_LIBHDFS3_CLIENT_DIGESTMD5_H_
+
+#include <openssl/evp.h>
+
+#include <cstdint>
+#include <string>
+
+namespace Hdfs {
+namespace Internal {
+
+/**
+ * Client side of SASL DIGEST-MD5 (RFC 2831) as used by the DataNode
+ * handshake: authentication with integrity (auth-int) and confidentiality
+ * (auth-conf, 3DES) security layers. GNU SASL's DIGEST-MD5 has no
+ * confidentiality layer, which privacy-protected DataNodes require.
+ */
+class DigestMd5Client {
+public:
+    // Security layer bits, as in SASL.
+    static const int QOP_AUTH = 1;
+    static const int QOP_AUTH_INT = 2;
+    static const int QOP_AUTH_CONF = 4;
+
+    /**
+     * @param username the SASL user name (e.g. the base64 block token identifier).
+     * @param password the SASL password (e.g. the base64 block token password).
+     * @param digestUri the digest-uri, "hdfs/0" for DataNodes.
+     */
+    DigestMd5Client(const std::string & username, const std::string & password,
+                    const std::string & digestUri);
+
+    ~DigestMd5Client();
+
+    /**
+     * Answer the server's challenge, choosing the strongest security layer
+     * the server offers within `allowedQops` (QOP_* bits).
+     */
+    std::string respond(const std::string & challenge, int allowedQops);
+
+    /**
+     * Check the server's final message (rspauth) and set up the security layer.
+     */
+    void complete(const std::string & serverFinal);
+
+    int getQop() const {
+        return qop;
+    }
+
+    bool hasSecurityLayer() const {
+        return done && qop != QOP_AUTH;
+    }
+
+    std::string wrap(const std::string & data);
+
+    std::string unwrap(const std::string & data);
+
+private:
+    std::string computeResponse(bool initial) const;
+    std::string a1() const;
+
+private:
+    std::string username;
+    std::string password;
+    std::string digestUri;
+    std::string realm;
+    std::string nonce;
+    std::string cnonce;
+    int qop;
+    bool done;
+    std::string kic, kis;
+    EVP_CIPHER_CTX * encryptor;
+    EVP_CIPHER_CTX * decryptor;
+    uint32_t sendSeq;
+    uint32_t recvSeq;
+};
+
+}
+}
+
+#endif /* _HDFS_LIBHDFS3_CLIENT_DIGESTMD5_H_ */
