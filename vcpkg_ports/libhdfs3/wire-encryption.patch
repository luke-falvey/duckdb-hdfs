+
+using namespace ::google::protobuf::io;
+
+namespace Hdfs {
+namespace Internal {
+
+RpcSaslSocket::RpcSaslSocket(shared_ptr<Socket> inner, shared_ptr<SaslClient> sasl,
+                             const std::string & clientId) :
+    WrappedSocket(inner), sasl(sasl), clientId(clientId) {
+}
+
+void RpcSaslSocket::fill(int timeout) {
+    char lengthBytes[4];
+    inner->readFully(lengthBytes, sizeof(lengthBytes), timeout);
+    uint32_t length = (static_cast<uint32_t>(static_cast<unsigned char>(lengthBytes[0])) << 24)
+                      | (static_cast<uint32_t>(static_cast<unsigned char>(lengthBytes[1])) << 16)
+                      | (static_cast<uint32_t>(static_cast<unsigned char>(lengthBytes[2])) << 8)
+                      | static_cast<uint32_t>(static_cast<unsigned char>(lengthBytes[3]));
+
+    if (length == 0 || length > 256 * 1024 * 1024) {
+        THROW(HdfsRpcException, "RpcSaslSocket: invalid wrapped RPC message length %u", length);
+    }
+
+    std::vector<char> frame(length);
+    inner->readFully(frame.data(), static_cast<int32_t>(length), timeout);
+    CodedInputStream stream(reinterpret_cast<const uint8_t *>(frame.data()), static_cast<int>(length));
+    RpcResponseHeaderProto header;
+    uint32_t size = 0;
+
+    if (!stream.ReadVarint32(&size)) {
+        THROW(HdfsRpcException, "RpcSaslSocket: cannot read the RPC response header");
+    }
+
+    CodedInputStream::Limit limit = stream.PushLimit(static_cast<int>(size));
+
+    if (!header.ParseFromCodedStream(&stream)) {
+        THROW(HdfsRpcException, "RpcSaslSocket: cannot parse the RPC response header");
+    }
+
+    stream.PopLimit(limit);
+
+    if (header.status() != RpcResponseHeaderProto_RpcStatusProto_SUCCESS) {
+        THROW(HdfsRpcServerException, "%s: %s", header.exceptionclassname().c_str(),
+              header.errormsg().c_str());
+    }
+
+    RpcSaslProto message;
+
+    if (!stream.ReadVarint32(&size)) {
+        THROW(HdfsRpcException, "RpcSaslSocket: cannot read the wrapped RPC message");
+    }
+
+    limit = stream.PushLimit(static_cast<int>(size));
+
+    if (!message.ParseFromCodedStream(&stream)) {
+        THROW(HdfsRpcException, "RpcSaslSocket: cannot parse the wrapped RPC message");
+    }
+
+    stream.PopLimit(limit);
+
+    if (message.state() != RpcSaslProto_SaslState_WRAP) {
+        THROW(HdfsRpcException, "RpcSaslSocket: expected a wrapped RPC message, got SASL state %d",
+              static_cast<int>(message.state()));
+    }
+
+    std::lock_guard<std::mutex> lock(saslMutex);
+    plain.append(sasl->decode(message.token()));
+}
+
+void RpcSaslSocket::send(const char * buffer, int32_t size, int timeout) {
+    RpcSaslProto message;
+    message.set_state(RpcSaslProto_SaslState_WRAP);
+    {
+        std::lock_guard<std::mutex> lock(saslMutex);
+        message.set_token(sasl->encode(std::string(buffer, size)));
+    }
+    RpcRequestHeaderProto header;
+    header.set_callid(AuthProtocol::SASL);
+    header.set_clientid(clientId);
+    header.set_retrycount(INVALID_RETRY_COUNT);
+    header.set_rpckind(RPC_PROTOCOL_BUFFER);
+    header.set_rpcop(RpcRequestHeaderProto_OperationProto_RPC_FINAL_PACKET);
+    RpcContentWrapper wrapper(&header, &message);
+    WriteBuffer out;
+    out.writeBigEndian(static_cast<int32_t>(wrapper.getLength()));
+    wrapper.writeTo(out);
+    inner->writeFully(out.getBuffer(0), static_cast<int32_t>(out.getDataSize(0)), timeout);
+}
+
+}
