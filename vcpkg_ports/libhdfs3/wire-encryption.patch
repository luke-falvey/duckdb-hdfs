+#ifndef _HDFS_LIBHDFS3_NETWORK_WRAPPEDSOCKET_H_
+#define _HDFS_LIBHDFS3_NETWORK_WRAPPEDSOCKET_H_
+
+#include "Memory.h"
+#include "Socket.h"
+
+#include <string>
+
+namespace Hdfs {
+namespace Internal {
+
+/**
+ * A connected socket whose traffic passes through a security layer (SASL
+ * wrap/unwrap or a stream cipher). Writes are transformed and sent on the
+ * inner socket; reads are served from a buffer of decoded bytes that is
+ * refilled from the inner socket. The wrapper is installed after the
+ * handshake, so the code above it reads and writes plaintext as before.
+ */
+class WrappedSocket: public Socket {
+public:
+    explicit WrappedSocket(shared_ptr<Socket> inner);
+
+    int32_t read(char * buffer, int32_t size);
+
+    void readFully(char * buffer, int32_t size, int timeout);
+
+    int32_t write(const char * buffer, int32_t size);
+
+    void writeFully(const char * buffer, int32_t size, int timeout);
+
+    void connect(const char * host, int port, int timeout);
+
+    void connect(const char * host, const char * port, int timeout);
+
+    void connect(struct addrinfo * paddr, const char * host, const char * port, int timeout);
+
+    bool poll(bool read, bool write, int timeout);
+
+    void setBlockMode(bool enable);
+
+    void setNoDelay(bool enable);
+
+    void setLingerTimeout(int timeout);
+
+    void disableSigPipe();
+
+    void close();
+
+protected:
+    /**
+     * Read the next unit of protected data from the inner socket and append
+     * its decoded bytes to `plain` (at least one byte, or throw).
+     * @param timeout the read timeout in milliseconds, -1 for none.
+     */
+    virtual void fill(int timeout) = 0;
+
+    /**
+     * Protect `size` bytes and send them on the inner socket.
+     */
+    virtual void send(const char * buffer, int32_t size, int timeout) = 0;
+
+    shared_ptr<Socket> inner;
+    std::string plain;
+    size_t offset;
+};
+
+}
+}
+
+#endif /* _HDFS_LIBHDFS3_NETWORK_WRAPPEDSOCKET_H_ */
