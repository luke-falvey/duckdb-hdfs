+namespace {
+
+const int32_t SASL_TRANSFER_MAGIC_NUMBER = static_cast<int32_t>(0xDEADBEEF);
+const int AES_CTR_NOPADDING = 2;
+// Largest plaintext chunk per wrapped message (the DataNode's maxbuf is 64KiB).
+const size_t MAX_WRAP_CHUNK = 32 * 1024;
+
+std::string Base64(const std::string & data) {
+    std::vector<unsigned char> out(4 * ((data.size() + 2) / 3) + 1);
+    int len = EVP_EncodeBlock(out.data(), reinterpret_cast<const unsigned char *>(data.data()),
+                              static_cast<int>(data.size()));
+    return std::string(reinterpret_cast<char *>(out.data()), len);
+}
+
+// dfs.data.transfer.protection -> DIGEST-MD5 QOP bits.
+int AllowedQops(const std::string & protection) {
+    int qops = 0;
+    size_t start = 0;
+
+    while (start <= protection.size()) {
+        size_t comma = protection.find(',', start);
+        std::string item = protection.substr(start, comma == std::string::npos ? std::string::npos : comma - start);
+        item.erase(0, item.find_first_not_of(" \t"));
+        item.erase(item.find_last_not_of(" \t") + 1);
+
+        if (item == "authentication") {
+            qops |= DigestMd5Client::QOP_AUTH;
+        } else if (item == "integrity") {
+            qops |= DigestMd5Client::QOP_AUTH_INT;
+        } else if (item == "privacy") {
+            qops |= DigestMd5Client::QOP_AUTH_CONF;
+        } else if (!item.empty()) {
+            THROW(HdfsConfigInvalid, "Invalid dfs.data.transfer.protection value \"%s\"", item.c_str());
+        }
+
+        if (comma == std::string::npos) {
+            break;
+        }
+
+        start = comma + 1;
+    }
+
+    return qops;
+}
+
+void WriteMessage(Socket & sock, const DataTransferEncryptorMessageProto & message, int timeout) {
+    std::string body;
+    message.SerializeToString(&body);
+    std::string out;
+    uint32_t size = static_cast<uint32_t>(body.size());
+
+    do {
+        unsigned char byte = size & 0x7F;
+        size >>= 7;
+
+        if (size) {
+            byte |= 0x80;
+        }
+
+        out += static_cast<char>(byte);
+    } while (size);
+
+    out += body;
+    sock.writeFully(out.data(), static_cast<int32_t>(out.size()), timeout);
+}
+
+DataTransferEncryptorMessageProto ReadMessage(Socket & sock, int timeout) {
+    uint32_t size = 0;
+
+    for (int shift = 0; shift < 35; shift += 7) {
+        char c;
+        sock.readFully(&c, 1, timeout);
+        size |= static_cast<uint32_t>(c & 0x7F) << shift;
+
+        if (!(c & 0x80)) {
+            break;
+        }
+    }
+
+    if (size > 1024 * 1024) {
+        THROW(HdfsIOException, "DataNode SASL: invalid message size %u", size);
+    }
+
+    std::vector<char> body(size);
+
+    if (size) {
+        sock.readFully(body.data(), static_cast<int32_t>(size), timeout);
+    }
+
+    DataTransferEncryptorMessageProto message;
+
+    if (!message.ParseFromArray(body.data(), static_cast<int>(size))) {
+        THROW(HdfsIOException, "DataNode SASL: cannot parse the DataNode's message");
+    }
+
+    if (message.status() != DataTransferEncryptorMessageProto_DataTransferEncryptorStatus_SUCCESS) {
+        if (message.status() == DataTransferEncryptorMessageProto_DataTransferEncryptorStatus_ERROR_UNKNOWN_KEY) {
+            THROW(HdfsIOException, "DataNode SASL: the DataNode doesn't know the data encryption key: %s",
+                  message.message().c_str());
+        }
+
+        THROW(AccessControlException, "DataNode SASL handshake failed: %s",
+              message.has_message() ? message.message().c_str() : "check the DataNode's log");
+    }
+
+    return message;
+}
+
+/**
+ * DataNode traffic protected by the DIGEST-MD5 security layer: each message
+ * is a 4-byte big-endian length followed by the wrapped bytes.
+ */
+class DigestSaslSocket: public WrappedSocket {
+public:
+    DigestSaslSocket(shared_ptr<Socket> inner, shared_ptr<DigestMd5Client> sasl) :
+        WrappedSocket(inner), sasl(sasl) {
+    }
+
+protected:
+    void fill(int timeout) {
+        char lengthBytes[4];
+        inner->readFully(lengthBytes, 4, timeout);
+        uint32_t length = (static_cast<uint32_t>(static_cast<unsigned char>(lengthBytes[0])) << 24)
+                          | (static_cast<uint32_t>(static_cast<unsigned char>(lengthBytes[1])) << 16)
+                          | (static_cast<uint32_t>(static_cast<unsigned char>(lengthBytes[2])) << 8)
+                          | static_cast<uint32_t>(static_cast<unsigned char>(lengthBytes[3]));
+
+        if (length == 0 || length > 16 * 1024 * 1024) {
+            THROW(HdfsIOException, "DataNode SASL: invalid wrapped message length %u", length);
+        }
+
+        std::string wrapped(length, '\0');
+        inner->readFully(&wrapped[0], static_cast<int32_t>(length), timeout);
+        plain.append(sasl->unwrap(wrapped));
+    }
+
+    void send(const char * buffer, int32_t size, int timeout) {
+        for (int32_t done = 0; done < size;) {
+            int32_t chunk = static_cast<int32_t>(std::min<size_t>(size - done, MAX_WRAP_CHUNK));
+            std::string wrapped = sasl->wrap(std::string(buffer + done, chunk));
+            uint32_t length = static_cast<uint32_t>(wrapped.size());
+            char lengthBytes[4] = {static_cast<char>(length >> 24), static_cast<char>(length >> 16),
+                                   static_cast<char>(length >> 8), static_cast<char>(length)};
+            inner->writeFully(lengthBytes, 4, timeout);
+            inner->writeFully(wrapped.data(), static_cast<int32_t>(wrapped.size()), timeout);
+            done += chunk;
+        }
+    }
+
+private:
+    shared_ptr<DigestMd5Client> sasl;
+};
+
+EVP_CIPHER_CTX * NewAesCtr(const std::string & key, const std::string & iv) {
+    const EVP_CIPHER * cipher = key.size() == 16 ? EVP_aes_128_ctr()
+                                : key.size() == 24 ? EVP_aes_192_ctr()
+                                : key.size() == 32 ? EVP_aes_256_ctr() : NULL;
+
+    if (!cipher || iv.size() != 16) {
+        THROW(HdfsIOException, "DataNode SASL: invalid AES key or IV length");
+    }
+
+    EVP_CIPHER_CTX * ctx = EVP_CIPHER_CTX_new();
+
+    if (!ctx || EVP_EncryptInit_ex(ctx, cipher, NULL, reinterpret_cast<const unsigned char *>(key.data()),
+                                   reinterpret_cast<const unsigned char *>(iv.data())) != 1) {
+        EVP_CIPHER_CTX_free(ctx);
+        THROW(HdfsIOException, "DataNode SASL: cannot initialize AES/CTR");
+    }
+
+    return ctx;
+}
+
+/**
+ * DataNode traffic encrypted with the negotiated AES/CTR stream cipher (one
+ * keystream per direction, continued across the whole connection).
+ */
+class AesCtrSocket: public WrappedSocket {
+public:
+    AesCtrSocket(shared_ptr<Socket> inner, const std::string & sendKey, const std::string & sendIv,
+                 const std::string & recvKey, const std::string & recvIv) :
+        WrappedSocket(inner), encryptor(NewAesCtr(sendKey, sendIv)), decryptor(NewAesCtr(recvKey, recvIv)) {
+    }
+
+    ~AesCtrSocket() {
+        EVP_CIPHER_CTX_free(encryptor);
+        EVP_CIPHER_CTX_free(decryptor);
+    }
+
+protected:
+    void fill(int timeout) {
+        if (!inner->poll(true, false, timeout)) {
+            THROW(HdfsTimeoutException, "Read timeout from DataNode");
+        }
+
+        char buffer[64 * 1024];
+        int32_t n = inner->read(buffer, sizeof(buffer));
+        plain.append(transform(decryptor, buffer, n));
+    }
+
+    void send(const char * buffer, int32_t size, int timeout) {
+        std::string encrypted = transform(encryptor, buffer, size);
+        inner->writeFully(encrypted.data(), static_cast<int32_t>(encrypted.size()), timeout);
+    }
+
+private:
+    static std::string transform(EVP_CIPHER_CTX * ctx, const char * data, int32_t size) {
+        std::string out(size, '\0');
+        int len = 0;
+
+        if (EVP_EncryptUpdate(ctx, reinterpret_cast<unsigned char *>(&out[0]), &len,
+                              reinterpret_cast<const unsigned char *>(data), size) != 1) {
+            THROW(HdfsIOException, "DataNode SASL: AES/CTR failed");
+        }
+
+        return out;
+    }
+
+    EVP_CIPHER_CTX * encryptor;
+    EVP_CIPHER_CTX * decryptor;
+};
+
+}
+
+shared_ptr<Socket> NegotiateDataTransferSasl(shared_ptr<Socket> sock, const DatanodeInfo & datanode,
+                                             const Token & token, const SessionConfig & conf,
+                                             const DataEncryptionKey * key, int timeout) {
+    shared_ptr<DigestMd5Client> sasl;
+    int allowedQops;
+
+    if (key) {
+        // dfs.encrypt.data.transfer: the NameNode's key, always encrypted.
+        std::string username = std::to_string(key->keyId) + " " + key->blockPoolId + " " + Base64(key->nonce);
+        sasl = shared_ptr<DigestMd5Client>(new DigestMd5Client(username, Base64(key->encryptionKey), "hdfs/0"));
+        allowedQops = DigestMd5Client::QOP_AUTH_CONF;
+    } else if (conf.getRpcAuthMethod() != "kerberos" || token.getIdentifier().empty()
+               || datanode.getXferPort() <= 1024 || conf.getDataTransferProtection().empty()) {
+        // Not secured, or trusted through a privileged port.
+        return sock;
+    } else {
+        sasl = shared_ptr<DigestMd5Client>(new DigestMd5Client(Base64(token.getIdentifier()),
+                                                               Base64(token.getPassword()), "hdfs/0"));
+        allowedQops = AllowedQops(conf.getDataTransferProtection());
+    }
+
+    char magic[4] = {static_cast<char>(SASL_TRANSFER_MAGIC_NUMBER >> 24),
+                     static_cast<char>(SASL_TRANSFER_MAGIC_NUMBER >> 16),
+                     static_cast<char>(SASL_TRANSFER_MAGIC_NUMBER >> 8),
+                     static_cast<char>(SASL_TRANSFER_MAGIC_NUMBER)};
+    sock->writeFully(magic, 4, timeout);
+
+    DataTransferEncryptorMessageProto hello;
+    hello.set_status(DataTransferEncryptorMessageProto_DataTransferEncryptorStatus_SUCCESS);
+    hello.set_payload("");
+    WriteMessage(*sock, hello, timeout);
+
+    DataTransferEncryptorMessageProto challenge = ReadMessage(*sock, timeout);
+    DataTransferEncryptorMessageProto response;
+    response.set_status(DataTransferEncryptorMessageProto_DataTransferEncryptorStatus_SUCCESS);
+    response.set_payload(sasl->respond(challenge.payload(), allowedQops));
+
+    if (sasl->getQop() == DigestMd5Client::QOP_AUTH_CONF) {
+        // Offer AES/CTR; the DataNode uses it if dfs.encrypt.data.transfer.cipher.suites allows.
+        response.add_cipheroption()->set_suite(AES_CTR_NOPADDING);
+    }
+
+    WriteMessage(*sock, response, timeout);
+    DataTransferEncryptorMessageProto last = ReadMessage(*sock, timeout);
+    sasl->complete(last.payload());
+
+    if (last.cipheroption_size() > 0 && last.cipheroption(0).suite() == AES_CTR_NOPADDING) {
+        const HdfsCipherOptionProto & cipher = last.cipheroption(0);
+        // The keys come wrapped by the SASL layer. For the client, "in" is the
+        // direction towards the DataNode.
+        return shared_ptr<Socket>(new AesCtrSocket(sock, sasl->unwrap(cipher.inkey()), cipher.iniv(),
+                                                   sasl->unwrap(cipher.outkey()), cipher.outiv()));
+    }
+
+    if (sasl->hasSecurityLayer()) {
+        return shared_ptr<Socket>(new DigestSaslSocket(sock, sasl));
+    }
+
+    return sock;
+}
+
+}
+}
