+        key.keyId = proto.keyid();
+        key.blockPoolId = proto.blockpoolid();
+        key.nonce = proto.nonce();
+        key.encryptionKey = proto.encryptionkey();
+        key.expiryDate = static_cast<int64_t>(proto.expirydate());
+        key.encryptionAlgorithm = proto.encryptionalgorithm();
+        return true;
+    } catch (const HdfsRpcServerException & e) {
+        UnWrapper < HdfsIOException > unwrapper(e);
+        unwrapper.unwrap(__FILE__, __LINE__);
+    }
+
