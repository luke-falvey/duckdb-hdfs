+#ifndef _HDFS_LIBHDFS3_CLIENT_DATATRANSFERSASL_H_
+#define _HDFS_LIBHDFS3_CLIENT_DATATRANSFERSASL_H_
+
+#include "Memory.h"
+#include "network/Socket.h"
+
+#include <cstdint>
+#include <string>
+
+namespace Hdfs {
+namespace Internal {
+
+class DatanodeInfo;
+class SessionConfig;
+class Token;
+
+/**
+ * The NameNode's key for encrypting DataNode traffic (dfs.encrypt.data.transfer).
+ */
+struct DataEncryptionKey {
+    uint32_t keyId = 0;
+    std::string blockPoolId;
+    std::string nonce;
+    std::string encryptionKey;
+    int64_t expiryDate = 0;
+    std::string encryptionAlgorithm;
+};
+
+/**
+ * Run the DataNode SASL handshake (Hadoop's SaslDataTransferClient) on a
+ * freshly connected socket, before any data transfer operation:
+ *
+ * - with `key` (dfs.encrypt.data.transfer), authenticate with the NameNode's
+ *   encryption key and always protect the connection;
+ * - otherwise, on a Kerberos cluster with dfs.data.transfer.protection set and
+ *   an unprivileged DataNode port, authenticate with the block token;
+ * - otherwise the connection is used as is.
+ *
+ * Returns the socket to use: `sock` itself, or a wrapper applying the
+ * negotiated protection (DIGEST-MD5 integrity/privacy, or an AES/CTR stream
+ * cipher when one was negotiated).
+ */
+shared_ptr<Socket> NegotiateDataTransferSasl(shared_ptr<Socket> sock, const DatanodeInfo & datanode,
+                                             const Token & token, const SessionConfig & conf,
+                                             const DataEncryptionKey * key, int timeout);
+
+}
+}
+
+#endif /* _HDFS_LIBHDFS3_CLIENT_DATATRANSFERSASL_H_ */
