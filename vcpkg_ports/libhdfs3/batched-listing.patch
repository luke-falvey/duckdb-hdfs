+bool NamenodeProxy::getBatchedListing(const std::vector<std::string> & srcs,
+                                      std::string & startAfter, bool needLocation,
+                                      std::vector<BatchedListing> & out) {
+    // A retry after failover repeats the whole call: drop partial output.
+    size_t mark = out.size();
+    std::string key = startAfter;
+    NAMENODE_HA_RETRY_BEGIN();
+    out.resize(mark);
+    startAfter = key;
+    return namenode->getBatchedListing(srcs, startAfter, needLocation, out);
+    NAMENODE_HA_RETRY_END();
+    assert(!"should not reach here");
+    return false;
+}
