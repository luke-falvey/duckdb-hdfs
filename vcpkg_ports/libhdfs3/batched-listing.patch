+bool NamenodeImpl::getBatchedListing(const std::vector<std::string> & srcs,
+                                     std::string & startAfter, bool needLocation,
+                                     std::vector<BatchedListing> & out) {
+    // Errors of the call itself propagate as HdfsRpcServerException, so the
+    // caller can tell "not supported here" from a failure listing one path.
+    GetBatchedListingRequestProto request;
+    GetBatchedListingResponseProto response;
+
+    for (size_t i = 0; i < srcs.size(); ++i) {
+        request.add_paths(srcs[i]);
+    }
+
+    request.set_startafter(startAfter);
+    request.set_needlocation(needLocation);
+    invoke(RpcCall(true, "getBatchedListing", &request, &response));
+
+    for (int i = 0; i < response.listings_size(); ++i) {
+        const BatchedDirectoryListingProto & proto = response.listings(i);
+
+        if (proto.parentidx() >= srcs.size()) {
+            THROW(HdfsIOException, "getBatchedListing: invalid path index %u in the response",
+                  proto.parentidx());
+        }
+
+        BatchedListing listing;
+        listing.index = proto.parentidx();
+        const std::string & src = srcs[listing.index];
+
+        if (proto.has_exception()) {
+            try {
+                HdfsRpcServerException e(proto.exception().message(), __FILE__, __LINE__, "");
+                e.setErrClass(proto.exception().classname());
+                e.setErrMsg(proto.exception().message());
+                throw e;
+            } catch (...) {
+                listing.error = std::current_exception();
+            }
+        } else {
+            for (int j = 0; j < proto.partiallisting_size(); ++j) {
+                FileStatus status;
+                Convert(src, status, proto.partiallisting(j));
+                listing.entries.push_back(status);
+            }
+        }
+
+        out.push_back(std::move(listing));
+    }
+
+    startAfter = response.startafter();
+    return response.hasmore();
+}
