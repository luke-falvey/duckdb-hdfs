diff --git a/src/proto/hdfs.proto b/src/proto/hdfs.proto
index 5567bf6..716f85c 100644
--- a/src/proto/hdfs.proto
+++ b/src/proto/hdfs.proto
@@ -223,6 +223,20 @@ message LocatedBlocksProto {
  * Status of a file, directory or symlink
  * Optionally includes a file's block locations if requested by client on the rpc call.
  */
+/**
+ * Hadoop's FileEncryptionInfoProto: how a file in an encryption zone is
+ * encrypted. The enums are kept as plain numbers (same wire format):
+ * suite 2 = AES/CTR/NoPadding, cryptoProtocolVersion 2 = ENCRYPTION_ZONES.
+ */
+message HdfsFileEncryptionInfoProto {
+  optional uint32 suite = 1;
+  optional uint32 cryptoProtocolVersion = 2;
+  optional bytes key = 3;               // the encrypted data encryption key
+  optional bytes iv = 4;
+  optional string keyName = 5;
+  optional string ezKeyVersionName = 6;
+}
+
 message HdfsFileStatusProto {
   enum FileType {
     IS_DIR = 1;
@@ -250,6 +264,9 @@ message HdfsFileStatusProto {
   optional uint64 fileId = 13 [default = 0]; // default as an invalid id
   optional int32 childrenNum = 14 [default = -1];
 
+  // Optional field for file encryption
+  optional HdfsFileEncryptionInfoProto fileEncryptionInfo = 15;
+
   // Optional field for erasure coding
   optional ErasureCodingPolicyProto ecPolicy = 17;
 }
