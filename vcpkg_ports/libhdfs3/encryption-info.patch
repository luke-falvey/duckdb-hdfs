 namespace Hdfs {
 
+/**
+ * How a file in an HDFS encryption zone is encrypted (Hadoop's
+ * FileEncryptionInfo). `key` is the data encryption key, encrypted by the KMS.
+ */
+struct FileEncryptionInfo {
+    int suite = 0;
+    int protocolVersion = 0;
+    std::string key;
+    std::string iv;
+    std::string keyName;
+    std::string ezKeyVersionName;
+};
+
 class FileStatus {
 public:
     FileStatus() :
@@ -159,6 +172,20 @@ public:
         ecPolicy = policy;
     }
 
+    // Whether the file lives in an HDFS encryption zone.
+    bool isEncrypted() const {
+        return encrypted;
+    }
+
+    const FileEncryptionInfo & getEncryptionInfo() const {
+        return encryptionInfo;
+    }
+
+    void setEncryptionInfo(const FileEncryptionInfo & info) {
+        encryptionInfo = info;
+        encrypted = true;
+    }
+
     int64_t getFileId() const {
         return fileId;
     }
@@ -182,6 +209,8 @@ private:
     bool isStriped;
     Internal::shared_ptr<Internal::ECPolicy> ecPolicy;
     int64_t fileId;
+    bool encrypted = false;
+    FileEncryptionInfo encryptionInfo;
 };
 
 }
