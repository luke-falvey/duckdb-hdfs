# name: test/sql/hdfs.test
# description: Integration tests for the hdfs extension against a real HDFS.
# group: [sql]

#
# These tests require a running HDFS cluster (see test/docker) and the host-side
# client config on HADOOP_CONF_DIR. The easiest way to run them:
#
#     make                              # build the extension + duckdb
#     test/scripts/run_hdfs_tests.sh    # up -> run -> down
#
# They are skipped unless HDFS_TEST_RUNNING is set, so `make test` stays green
# without docker.

require hdfs

require-env HDFS_TEST_RUNNING

# The effective user comes from the Hadoop environment (HADOOP_USER_NAME here,
# set by run_hdfs_tests.sh) so writes to the hadoop-owned /test are permitted.

# --- reading CSV over hdfs:// ------------------------------------------------

query I
SELECT count(*) FROM read_csv('hdfs://localhost:9000/test/data.csv');
----
3

query IT
SELECT id, name FROM read_csv('hdfs://localhost:9000/test/data.csv') ORDER BY id;
----
1	alice
2	bob
3	carol

# The scheme-only form resolves the NameNode from fs.defaultFS
# (test/hdfs-conf/core-site.xml points it at localhost:9000).
query I
SELECT count(*) FROM read_csv('hdfs:///test/data.csv');
----
3

# --- globbing ----------------------------------------------------------------

# Wildcard against the two seeded fixtures (data.csv + data.parquet). Patterned
# on "data.*" so it stays deterministic even if other files are written below.
query I
SELECT count(*) FROM glob('hdfs://localhost:9000/test/data.*');
----
2

# A single '*' matches one path level only (not the nested/ subdirectory).
query I
SELECT count(*) FROM glob('hdfs://localhost:9000/test/*.parquet');
----
1

# A bare '*' matches the two top-level files plus the nested/ directory, but
# directories are filtered out of glob results (so readers never try to open a
# directory as a data file). Run before any writes so the count is stable.
query I
SELECT count(*) FROM glob('hdfs://localhost:9000/test/*');
----
2

# '**' crawls the subtree (matching zero or more levels, like DuckDB's local
# globber): the two top-level files plus nested/more.parquet.
query I
SELECT count(*) FROM glob('hdfs://localhost:9000/test/**');
----
3

query I
SELECT count(*) FROM glob('hdfs://localhost:9000/test/**/*.parquet');
----
2

# Reading a glob pattern directly expands to the matching files.
query I
SELECT count(*) FROM read_csv('hdfs://localhost:9000/test/data*.csv');
----
3

# --- metadata functions: hdfs_ls / hdfs_stat / hdfs_exists --------------------
# Run before any writes so /test holds exactly data.csv, data.parquet, nested/
# (and nested/ holds more.parquet).

# hdfs_ls lists a directory's immediate children, directories included (unlike
# glob(), which drops them).
query TT
SELECT name, type FROM hdfs_ls('hdfs://localhost:9000/test') ORDER BY name;
----
data.csv	file
data.parquet	file
nested	directory

# The path column carries the authority back as a full hdfs:// URL.
query T
SELECT path FROM hdfs_ls('hdfs://localhost:9000/test') WHERE name = 'nested';
----
hdfs://localhost:9000/test/nested

# Full metadata is populated: owner non-empty and permissions are 9 chars.
query I
SELECT count(*) FROM hdfs_ls('hdfs://localhost:9000/test')
WHERE length(owner) > 0 AND length(permissions) = 9;
----
3

# Files carry replication / block_size; directories report them as NULL.
query I
SELECT count(*) FROM hdfs_ls('hdfs://localhost:9000/test')
WHERE name = 'data.csv' AND replication >= 1 AND block_size > 0;
----
1

query I
SELECT count(*) FROM hdfs_ls('hdfs://localhost:9000/test')
WHERE name = 'nested' AND replication IS NULL AND block_size IS NULL;
----
1

# A terminal '**' crawls the subtree (nested/ holds more.parquet at this
# point) and yields the nested directory entry itself too — the replacement
# for the old recursive := true parameter.
query I
SELECT count(*) FROM hdfs_ls('hdfs://localhost:9000/test/**');
----
4

# hdfs_list_parallelism bounds the concurrent listing RPCs of a multi-directory
# walk, which streams entries as the background walk produces them. Row order
# is completion order (not guaranteed), so always ORDER BY here.
query T
SELECT current_setting('hdfs_list_parallelism');
----
16

statement ok
SET hdfs_list_parallelism = 1;

query T
SELECT name FROM hdfs_ls('hdfs://localhost:9000/test/**') ORDER BY name;
----
data.csv
data.parquet
more.parquet
nested

statement ok
SET hdfs_list_parallelism = 64;

query T
SELECT name FROM hdfs_ls('hdfs://localhost:9000/test/**') ORDER BY name;
----
data.csv
data.parquet
more.parquet
nested

statement ok
RESET hdfs_list_parallelism;

# --- glob patterns in hdfs_ls --------------------------------------------------

# A wildcard switches hdfs_ls to glob semantics: the matched entries themselves
# come back (files and directories both), without listing into matched dirs.
query TT
SELECT name, type FROM hdfs_ls('hdfs://localhost:9000/test/*') ORDER BY name;
----
data.csv	file
data.parquet	file
nested	directory

# '**' matches zero or more levels, so both parquet files match here.
query T
SELECT name FROM hdfs_ls('hdfs://localhost:9000/test/**/*.parquet') ORDER BY name;
----
data.parquet
more.parquet

# '?' matches exactly one character; character classes support ranges.
query T
SELECT name FROM hdfs_ls('hdfs://localhost:9000/test/data.c??') ORDER BY name;
----
data.csv

query TT
SELECT name, type FROM hdfs_ls('hdfs://localhost:9000/test/[a-n]*') ORDER BY name;
----
data.csv	file
data.parquet	file
nested	directory

# {a,b} alternation, including alternatives spanning a '/'.
query T
SELECT name FROM hdfs_ls('hdfs://localhost:9000/test/data.{csv,parquet}') ORDER BY name;
----
data.csv
data.parquet

query T
SELECT name FROM hdfs_ls('hdfs://localhost:9000/test/{data.csv,nested/more.parquet}') ORDER BY name;
----
data.csv
more.parquet

# A pattern matching nothing is an empty result, not an error.
query I
SELECT count(*) FROM hdfs_ls('hdfs://localhost:9000/test/zzz*');
----
0

# An invalid pattern errors at open.
statement error
SELECT * FROM hdfs_ls('hdfs://localhost:9000/test/**/a/**');
----
multiple '**'

# hdfs_stat returns exactly one row for a single path, file or directory.
query TT
SELECT name, type FROM hdfs_stat('hdfs://localhost:9000/test/nested');
----
nested	directory

query TT
SELECT name, type FROM hdfs_stat('hdfs://localhost:9000/test/data.parquet');
----
data.parquet	file

# Stat on a missing path errors.
statement error
SELECT * FROM hdfs_stat('hdfs://localhost:9000/test/does_not_exist');
----
Failed to stat HDFS path 'hdfs://localhost:9000/test/does_not_exist'

# hdfs_exists is a scalar boolean predicate (true for files and directories).
query I
SELECT count(*) FROM range(1) WHERE hdfs_exists('hdfs://localhost:9000/test/data.csv');
----
1

query I
SELECT count(*) FROM range(1) WHERE hdfs_exists('hdfs://localhost:9000/test/nested');
----
1

query I
SELECT count(*) FROM range(1) WHERE hdfs_exists('hdfs://localhost:9000/test/does_not_exist');
----
0

# A walk abandoned after the first row (LIMIT) stops its workers cleanly; the
# loop repeats it because teardown used to race with workers starting threads.
loop i 0 20

query I
SELECT count(*) FROM (SELECT path FROM hdfs_ls('hdfs://localhost:9000/**', include_hidden := true) LIMIT 1);
----
1

endloop

# More rows than one output vector (2048): 1,100 partition directories, each
# holding one file.
statement ok
COPY (SELECT range AS p, range AS v FROM range(1100)) TO 'hdfs://localhost:9000/many' (FORMAT csv, PARTITION_BY (p));

query III
SELECT count(*), count(*) FILTER (type = 'directory'), count(DISTINCT path) FROM hdfs_ls('hdfs://localhost:9000/many/**');
----
2200	1100	2200

query I
SELECT count(*) FROM read_csv('hdfs://localhost:9000/many/*/*.csv');
----
1100

query I
SELECT count(*) FROM (SELECT * FROM hdfs_ls('hdfs://localhost:9000/many/**') LIMIT 0);
----
0

# The same walk listing one directory per NameNode call.
statement ok
SET hdfs_batched_listing = false;

query II
SELECT count(*), count(*) FILTER (type = 'directory') FROM hdfs_ls('hdfs://localhost:9000/many/**');
----
2200	1100

query I
SELECT count(*) FROM glob('hdfs://localhost:9000/many/*/*.csv');
----
1100

statement ok
RESET hdfs_batched_listing;

# Glob results come back sorted by path, as with local globs, although the
# walk lists directories in parallel.
query I
SELECT list(file) = list_sort(list(file)) FROM glob('hdfs://localhost:9000/many/*/*.csv');
----
true

# A file whose name contains glob characters: the pattern matches nothing, so
# the path is taken literally (as DuckDB's local glob does).
statement ok
COPY (SELECT 42 AS v) TO 'hdfs://localhost:9000/lit/data[1].csv' (FORMAT csv, HEADER);

query I
SELECT v FROM read_csv('hdfs://localhost:9000/lit/data[1].csv');
----
42

# A long walk stops at the query deadline (one listing call at a time, so it
# is still running when the deadline passes).
statement ok
SET hdfs_list_parallelism = 1;

statement ok
SET max_execution_time = 1;

statement error
SELECT count(*) FROM hdfs_ls('hdfs://localhost:9000/many/**');
----
Query exceeded maximum execution time

statement error
SELECT count(*) FROM read_csv('hdfs://localhost:9000/many/*/*.csv');
----
Query exceeded maximum execution time

statement ok
RESET max_execution_time;

statement ok
RESET hdfs_list_parallelism;

# --- hidden entries (/hidtest fixtures) ---------------------------------------
# Names starting with '_' or '.' (Hadoop's hidden convention) are excluded from
# listings, globs and scans by default: neither returned nor descended into.

query TT
SELECT name, type FROM hdfs_ls('hdfs://localhost:9000/hidtest') ORDER BY name;
----
nested	directory
visible.csv	file

# include_hidden := true restores them per call...
query TT
SELECT name, type FROM hdfs_ls('hdfs://localhost:9000/hidtest', include_hidden := true) ORDER BY name;
----
.staged.csv	file
_temporary	directory
nested	directory
visible.csv	file

# ...and a '**' crawl neither returns hidden entries nor walks into hidden
# directories (part-0001.csv inside _temporary stays invisible).
query T
SELECT name FROM hdfs_ls('hdfs://localhost:9000/hidtest/**') ORDER BY name;
----
more.csv
nested
visible.csv

query T
SELECT name FROM hdfs_ls('hdfs://localhost:9000/hidtest/**', include_hidden := true) ORDER BY name;
----
.staged.csv
_SUCCESS
_temporary
more.csv
nested
part-0001.csv
visible.csv

# Naming the hidden entry explicitly overrides the default (like the shell):
# a literal path, a pattern whose first character is the hidden one, or a
# literal component after a '**'.
query T
SELECT name FROM hdfs_ls('hdfs://localhost:9000/hidtest/_temporary') ORDER BY name;
----
part-0001.csv

query T
SELECT name FROM hdfs_ls('hdfs://localhost:9000/hidtest/_*') ORDER BY name;
----
_temporary

query T
SELECT name FROM hdfs_ls('hdfs://localhost:9000/hidtest/**/_SUCCESS') ORDER BY name;
----
_SUCCESS

query T
SELECT name FROM hdfs_ls('hdfs://localhost:9000/hidtest/.staged.csv');
----
.staged.csv

# hdfs_stat addresses one path directly and is unaffected.
query TT
SELECT name, type FROM hdfs_stat('hdfs://localhost:9000/hidtest/.staged.csv');
----
.staged.csv	file

# Scans follow the same rule; the hdfs_include_hidden setting also covers
# read_csv / read_parquet / glob(), which take no per-call parameter.
query I
SELECT count(*) FROM read_csv('hdfs://localhost:9000/hidtest/**/*.csv');
----
6

query I
SELECT count(*) FROM glob('hdfs://localhost:9000/hidtest/**');
----
2

statement ok
SET hdfs_include_hidden = true;

query I
SELECT count(*) FROM read_csv('hdfs://localhost:9000/hidtest/**/*.csv');
----
12

query I
SELECT count(*) FROM glob('hdfs://localhost:9000/hidtest/**');
----
5

statement ok
RESET hdfs_include_hidden;

# --- hdfs secrets -------------------------------------------------------------------

# A secret scoped to /permtest acts as the unprivileged user "guest" there,
# while the rest of the cluster keeps the environment's (super)user.
statement ok
CREATE SECRET as_guest (TYPE hdfs, SCOPE 'hdfs://localhost:9000/permtest', USER 'guest');

statement error
SELECT * FROM hdfs_ls('hdfs://localhost:9000/permtest/locked');
----
Permission denied

query I
SELECT count(*) FROM hdfs_ls('hdfs://localhost:9000/permtest/open');
----
1

query I
SELECT count(*) FROM read_csv('hdfs://localhost:9000/test/data.csv');
----
3

statement ok
DROP SECRET as_guest;

query I
SELECT count(*) FROM hdfs_ls('hdfs://localhost:9000/permtest/locked');
----
1

# Scopes match whole path components: a secret for /permtest/lock doesn't apply
# to /permtest/locked (here the environment's superuser can list it).
statement ok
CREATE SECRET as_guest_prefix (TYPE hdfs, SCOPE 'hdfs://localhost:9000/permtest/lock', USER 'guest');

query I
SELECT count(*) FROM hdfs_ls('hdfs://localhost:9000/permtest/locked');
----
1

statement ok
DROP SECRET as_guest_prefix;

# Replacing a secret replaces its connection: the new USER takes effect.
statement ok
CREATE SECRET as_who (TYPE hdfs, SCOPE 'hdfs://localhost:9000/permtest/', USER 'guest');

statement error
SELECT * FROM hdfs_ls('hdfs://localhost:9000/permtest/locked');
----
Permission denied

statement ok
CREATE OR REPLACE SECRET as_who (TYPE hdfs, SCOPE 'hdfs://localhost:9000/permtest/', USER 'hadoop');

query I
SELECT count(*) FROM hdfs_ls('hdfs://localhost:9000/permtest/locked');
----
1

statement ok
DROP SECRET as_who;

# hdfs_reset_connections() drops the cached connections; the next access
# reconnects.
query I
SELECT connections_dropped > 0 FROM hdfs_reset_connections();
----
true

query I
SELECT count(*) FROM read_csv('hdfs://localhost:9000/test/data.csv');
----
3

query I
SELECT connections_dropped FROM hdfs_reset_connections();
----
1

query I
SELECT connections_dropped FROM hdfs_reset_connections();
----
0

# --- logging --------------------------------------------------------------------

# Opens, reads, writes and closes show up in DuckDB's FileSystem log.
statement ok
CALL enable_logging('FileSystem');

statement ok
COPY (SELECT 1 AS v) TO 'hdfs://localhost:9000/test/logged.csv' (FORMAT csv);

query I
SELECT count(*) FROM read_csv('hdfs://localhost:9000/test/logged.csv');
----
1

query II
SELECT DISTINCT fs, op FROM duckdb_logs_parsed('FileSystem') WHERE path = 'hdfs://localhost:9000/test/logged.csv' ORDER BY op;
----
HdfsFileSystem	CLOSE
HdfsFileSystem	OPEN
HdfsFileSystem	READ
HdfsFileSystem	WRITE

statement ok
CALL disable_logging();

# --- error handling ----------------------------------------------------------

# Opening a non-existent file surfaces a clear IO error.
statement error
SELECT * FROM read_csv('hdfs://localhost:9000/test/does_not_exist.csv');
----
No files found that match the pattern "hdfs://localhost:9000/test/does_not_exist.csv"

# --- everything below needs the parquet extension ------------------------
# Kept last, so the tests above still run without it.

require parquet

# --- reading Parquet over hdfs:// --------------------------------------------

query I
SELECT count(*) FROM read_parquet('hdfs://localhost:9000/test/data.parquet');
----
5

query IT
SELECT id, name FROM read_parquet('hdfs://localhost:9000/test/data.parquet') ORDER BY id LIMIT 1;
----
0	v0

# --- writing (COPY TO) then reading back -------------------------------------
# Writes go under nested/ so they can't perturb the /test/*.{csv,parquet} globs.

statement ok
COPY (SELECT 42 AS x, 'written' AS y) TO 'hdfs://localhost:9000/test/nested/written.parquet' (FORMAT parquet);

query IT
SELECT x, y FROM read_parquet('hdfs://localhost:9000/test/nested/written.parquet');
----
42	written

# Round-trip a larger relation through CSV.
statement ok
COPY (SELECT range AS n FROM range(1000)) TO 'hdfs://localhost:9000/test/nested/big.csv' (FORMAT csv, HEADER);

query II
SELECT count(*), sum(n) FROM read_csv('hdfs://localhost:9000/test/nested/big.csv');
----
1000	499500

# A partitioned write makes DuckDB core list the target directory — the
# FileSystem ListFiles/ListFilesExtended path, which nothing above exercises
# (hdfs_ls has its own route into the bridge).
statement ok
COPY (SELECT range % 2 AS p, range AS v FROM range(10))
TO 'hdfs://localhost:9000/test/nested/part' (FORMAT parquet, PARTITION_BY (p));

query TT
SELECT name, type FROM hdfs_ls('hdfs://localhost:9000/test/nested/part') ORDER BY name;
----
p=0	directory
p=1	directory

query I
SELECT count(*) FROM read_parquet('hdfs://localhost:9000/test/nested/part/*/*.parquet');
----
10

# Rewriting is refused because the listing finds the existing partitions...
statement error
COPY (SELECT range % 2 AS p, range AS v FROM range(10))
TO 'hdfs://localhost:9000/test/nested/part' (FORMAT parquet, PARTITION_BY (p));
----
not empty

# ...unless overwriting is requested.
statement ok
COPY (SELECT range % 2 AS p, range AS v FROM range(10))
TO 'hdfs://localhost:9000/test/nested/part' (FORMAT parquet, PARTITION_BY (p), OVERWRITE_OR_IGNORE);

# COPY to a temporary file then renames it over the target (FileSystem::MoveFile
# with overwrite). Run it twice so the second rename replaces an existing file.
statement ok
COPY (SELECT 1 AS v) TO 'hdfs://localhost:9000/test/nested/tmpfile.csv' (FORMAT csv, HEADER, USE_TMP_FILE true);

statement ok
COPY (SELECT 2 AS v) TO 'hdfs://localhost:9000/test/nested/tmpfile.csv' (FORMAT csv, HEADER, USE_TMP_FILE true);

query I
SELECT v FROM read_csv('hdfs://localhost:9000/test/nested/tmpfile.csv');
----
2

# A partitioned COPY that fails partway cleans up the output directory it
# created (CreateDirectoryExtended / RemoveDirectoryExtended).
statement error
COPY (SELECT range % 2 AS p, CASE WHEN range = 50000 THEN error('boom') ELSE range END AS v FROM range(100000))
TO 'hdfs://localhost:9000/test/nested/failed_part' (FORMAT parquet, PARTITION_BY (p));
----
boom

query I
SELECT hdfs_exists('hdfs://localhost:9000/test/nested/failed_part');
----
false

# A single-file COPY that fails partway leaves no file behind: the aborted
# write is removed, never completed (an HDFS close publishes the file).
statement error
COPY (SELECT CASE WHEN range = 500000 THEN error('boom') ELSE range END AS v FROM range(1000000))
TO 'hdfs://localhost:9000/test/nested/aborted.csv' (FORMAT csv);
----
boom

query I
SELECT hdfs_exists('hdfs://localhost:9000/test/nested/aborted.csv');
----
false

statement error
COPY (SELECT CASE WHEN range = 500000 THEN error('boom') ELSE range END AS v FROM range(1000000))
TO 'hdfs://localhost:9000/test/nested/aborted.parquet' (FORMAT parquet);
----
boom

query I
SELECT hdfs_exists('hdfs://localhost:9000/test/nested/aborted.parquet');
----
false

# A failing USE_TMP_FILE overwrite keeps the original file intact, and the
# temporary file is gone.
statement error
COPY (SELECT CASE WHEN range = 50000 THEN error('boom') ELSE 3 END AS v FROM range(100000))
TO 'hdfs://localhost:9000/test/nested/tmpfile.csv' (FORMAT csv, HEADER, USE_TMP_FILE true);
----
boom

query I
SELECT v FROM read_csv('hdfs://localhost:9000/test/nested/tmpfile.csv');
----
2

query I
SELECT hdfs_exists('hdfs://localhost:9000/test/nested/tmp_tmpfile.csv');
----
false

# Writing over an existing file without USE_TMP_FILE replaces it; a file that
# didn't exist is created exclusively (DuckDB's CSV writer asks for that).
statement ok
COPY (SELECT 1 AS v) TO 'hdfs://localhost:9000/test/nested/replaced.csv' (FORMAT csv, HEADER);

statement ok
COPY (SELECT 2 AS v) TO 'hdfs://localhost:9000/test/nested/replaced.csv' (FORMAT csv, HEADER);

query I
SELECT v FROM read_csv('hdfs://localhost:9000/test/nested/replaced.csv');
----
2

# Partition directories are created one level at a time (CreateDirectoryExtended
# honours SINGLE): as for local files, the output directory's parent must exist.
statement error
COPY (SELECT range % 2 AS a, range AS v FROM range(12))
TO 'hdfs://localhost:9000/test/nested/no_parent/part' (FORMAT csv, PARTITION_BY (a));
----
Failed to create HDFS directory

query I
SELECT hdfs_exists('hdfs://localhost:9000/test/nested/no_parent');
----
false

statement ok
COPY (SELECT range % 2 AS a, range % 3 AS b, range AS v FROM range(12))
TO 'hdfs://localhost:9000/test/nested/deep_part' (FORMAT csv, PARTITION_BY (a, b));

query I
SELECT count(*) FROM read_csv('hdfs://localhost:9000/test/nested/deep_part/*/*/*.csv');
----
12

# Concurrent positional reads: a multi-row-group Parquet file read by many
# threads at once.
statement ok
COPY (SELECT range AS n FROM range(100000)) TO 'hdfs://localhost:9000/test/nested/rowgroups.parquet' (FORMAT parquet, ROW_GROUP_SIZE 1000);

statement ok
SET threads = 8;

query II
SELECT count(*), sum(n) FROM read_parquet('hdfs://localhost:9000/test/nested/rowgroups.parquet');
----
100000	4999950000

statement ok
RESET threads;

# --- encryption zones ----------------------------------------------------------
# /ez is an encryption zone (key "ezkey" in the test cluster's KMS). Its
# contents are encrypted client-side; /.reserved/raw/... (superuser only)
# returns the stored bytes without decrypting them.

# A file written and encrypted by the Java client reads back as plaintext.
query IT
SELECT id, name FROM read_csv('hdfs://localhost:9000/ez/java_written.csv') ORDER BY id;
----
1	alice
2	bob
3	carol

query I
SELECT content::VARCHAR LIKE 'id,name%' FROM read_blob('hdfs://localhost:9000/.reserved/raw/ez/java_written.csv');
----
false

# Round-trip through DuckDB's own encrypted writes. Parquet reads come in at
# arbitrary offsets from many threads, exercising mid-block decryption.
statement ok
COPY (SELECT range AS n, md5(range::VARCHAR) AS h FROM range(200000))
TO 'hdfs://localhost:9000/ez/roundtrip.parquet' (FORMAT parquet, ROW_GROUP_SIZE 10000);

statement ok
SET threads = 8;

query III
SELECT count(*), sum(n), count(DISTINCT h) FROM read_parquet('hdfs://localhost:9000/ez/roundtrip.parquet');
----
200000	19999900000	200000

statement ok
RESET threads;

# What's stored is ciphertext: without decryption it isn't valid Parquet.
statement error
SELECT * FROM read_parquet('hdfs://localhost:9000/.reserved/raw/ez/roundtrip.parquet');
----
No magic bytes found at end of file

# CTR encryption keeps the size: the plaintext and stored sizes match.
query I
SELECT (SELECT size FROM hdfs_stat('hdfs://localhost:9000/ez/roundtrip.parquet')) =
       (SELECT size FROM hdfs_stat('hdfs://localhost:9000/.reserved/raw/ez/roundtrip.parquet'));
----
true

# Overwriting through a temporary file renames within the zone.
statement ok
COPY (SELECT 1 AS v) TO 'hdfs://localhost:9000/ez/tmp.csv' (FORMAT csv, HEADER, USE_TMP_FILE true);

statement ok
COPY (SELECT 2 AS v) TO 'hdfs://localhost:9000/ez/tmp.csv' (FORMAT csv, HEADER, USE_TMP_FILE true);

query I
SELECT v FROM read_csv('hdfs://localhost:9000/ez/tmp.csv');
----
2

# --- caching and read paths ----------------------------------------------------

# DuckDB counts hdfs:// as a local scheme, so its external file cache keeps
# HDFS reads only with cache_local_files.
statement ok
SET enable_external_file_cache = true;

statement ok
COPY (SELECT 1 AS v) TO 'hdfs://localhost:9000/test/cache.parquet' (FORMAT parquet);

query I
SELECT v FROM read_parquet('hdfs://localhost:9000/test/cache.parquet');
----
1

query I
SELECT count(*) FROM duckdb_external_file_cache() WHERE path LIKE 'hdfs://%/test/cache.parquet';
----
0

statement ok
SET cache_local_files = true;

query I
SELECT v FROM read_parquet('hdfs://localhost:9000/test/cache.parquet');
----
1

query I
SELECT count(*) > 0 FROM duckdb_external_file_cache() WHERE path LIKE 'hdfs://%/test/cache.parquet';
----
true

# A file overwritten between two scans is re-read, not served from the cache
# (validated by modification time and size). Both versions have the same
# size, so only the modification time tells them apart.

statement ok
COPY (SELECT 2 AS v) TO 'hdfs://localhost:9000/test/cache.parquet' (FORMAT parquet);

query I
SELECT v FROM read_parquet('hdfs://localhost:9000/test/cache.parquet');
----
2

statement ok
RESET cache_local_files;

# A CSV larger than DuckDB's read buffer: one thread reads it front to back,
# several threads read it at scattered offsets on shared streams; both must
# see the same bytes. Also inside an encryption zone, where decryption depends
# on the read offset.
statement ok
COPY (SELECT range AS v, md5(range::VARCHAR) AS s FROM range(1000000))
    TO 'hdfs://localhost:9000/test/seq.csv' (FORMAT csv, HEADER);

statement ok
COPY (SELECT range AS v, md5(range::VARCHAR) AS s FROM range(1000000))
    TO 'hdfs://localhost:9000/ez/seq.csv' (FORMAT csv, HEADER);

statement ok
