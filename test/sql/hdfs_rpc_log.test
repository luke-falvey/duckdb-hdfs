# name: test/sql/hdfs_rpc_log.test
# description: The HDFS log type: one entry per NameNode RPC, so the RPC budget of common operations is pinned.
# group: [sql]

# Needs the test cluster (see test/sql/hdfs.test), with the fixtures seeded by test/scripts/hdfs_up.sh.

require hdfs

require parquet

require-env HDFS_TEST_RUNNING

statement ok
CALL enable_logging('HDFS');

# --- a single-file read ---------------------------------------------------------
# Two RPCs: the scan's file list stats the path (an all-literal glob), and opening the file fetches its block
# locations. Parquet opens the file twice (metadata, then the scan); the second open shares the first reader.

query I
SELECT count(*) FROM read_parquet('hdfs://localhost:9000/test/data.parquet');
----
5

query TTT
SELECT op, path, ok FROM duckdb_logs_parsed('HDFS') ORDER BY op;
----
getBlockLocations	/test/data.parquet	true
getFileInfo	/test/data.parquet	true

query I
SELECT count(*) FROM duckdb_logs_parsed('HDFS') WHERE duration_us IS NULL OR duration_us < 0;
----
0

statement ok
CALL truncate_duckdb_logs();

# --- metadata-only reads -----------------------------------------------------------

# read_blob without the content column needs only the file's status: the scan's stat answers it, and the file is
# never opened (no getBlockLocations; in an encryption zone, no KMS call).
query T
SELECT size > 0 FROM read_blob('hdfs://localhost:9000/test/data.parquet');
----
true

query TT
SELECT op, path FROM duckdb_logs_parsed('HDFS');
----
getFileInfo	/test/data.parquet

statement ok
CALL truncate_duckdb_logs();

# --- listings --------------------------------------------------------------------

# A plain directory listing: one listing, however many entries (other test files may add some to /test).
query I
SELECT count(*) > 0 FROM hdfs_ls('hdfs://localhost:9000/test');
----
true

query TT
SELECT op, path FROM duckdb_logs_parsed('HDFS');
----
listDirectory	/test

statement ok
CALL truncate_duckdb_logs();

# A recursive walk without batching: one listing per directory (/hidtest, its _temporary and nested).
statement ok
SET hdfs_batched_listing = false;

query I
SELECT count(*) FROM hdfs_ls('hdfs://localhost:9000/hidtest/**', include_hidden := true);
----
7

query TI
SELECT op, count(*) FROM duckdb_logs_parsed('HDFS') GROUP BY op;
----
listDirectory	3

statement ok
RESET hdfs_batched_listing;

statement ok
CALL truncate_duckdb_logs();

# With batching, the two subdirectories (queued together by the root's listing) are listed in one call.
query I
SELECT count(*) FROM hdfs_ls('hdfs://localhost:9000/hidtest/**', include_hidden := true);
----
7

query TI
SELECT op, count(*) FROM duckdb_logs_parsed('HDFS') GROUP BY op ORDER BY op;
----
getBatchedListing	1
listDirectory	1

statement ok
CALL truncate_duckdb_logs();

# --- the literal fallback ------------------------------------------------------------

# A pattern that matches nothing may be a file whose name contains glob characters. One getFileInfo after the
# listing answers both whether it exists and what it is. Opening the file costs getBlockLocations on top: two
# here, against one for a plain read (Parquet's second open doesn't share the first reader on this path; not yet
# traced, docs/REVIEW_QUORUM_ROUND3.md). Pinned, so a change in either direction shows.
statement ok
COPY (SELECT 1 AS v) TO 'hdfs://localhost:9000/test/rpc[1].parquet' (FORMAT parquet);

statement ok
CALL truncate_duckdb_logs();

query I
SELECT v FROM read_parquet('hdfs://localhost:9000/test/rpc[1].parquet');
----
1

query TI
SELECT op, count(*) FROM duckdb_logs_parsed('HDFS') GROUP BY op ORDER BY op;
----
getBlockLocations	2
getFileInfo	1
listDirectory	1

statement ok
CALL truncate_duckdb_logs();

# hdfs_ls's own fallback: the same single getFileInfo, and a file is its own row (no second listing).
query TT
SELECT name, type FROM hdfs_ls('hdfs://localhost:9000/test/rpc[1].parquet');
----
rpc[1].parquet	file

query TI
SELECT op, count(*) FROM duckdb_logs_parsed('HDFS') GROUP BY op ORDER BY op;
----
getFileInfo	1
listDirectory	1

statement ok
CALL truncate_duckdb_logs();

# A name with glob characters that doesn't exist: no rows, and nothing after the stat.
query I
SELECT count(*) FROM hdfs_ls('hdfs://localhost:9000/test/rpc[9].parquet');
----
0

query TI
SELECT op, count(*) FROM duckdb_logs_parsed('HDFS') GROUP BY op ORDER BY op;
----
getFileInfo	1
listDirectory	1

statement ok
CALL truncate_duckdb_logs();

# --- a failed write ------------------------------------------------------------------

# A COPY that fails removes its file. The create and the delete both go to the query's log, whichever thread
# aborts the write (the handle logs to the query that opened it, not to whatever that thread last served).
statement error
COPY (SELECT CASE WHEN range = 50000 THEN error('boom') ELSE range END AS v FROM range(100000))
    TO 'hdfs://localhost:9000/test/rpc_abort.csv';
----
boom

query TT
SELECT op, ok FROM duckdb_logs_parsed('HDFS') WHERE path = '/test/rpc_abort.csv' AND op IN ('create', 'delete')
ORDER BY op;
----
create	true
delete	true

query I
SELECT count(DISTINCT query_id) FROM duckdb_logs_parsed('HDFS') WHERE path = '/test/rpc_abort.csv';
----
1

# count(DISTINCT) ignores NULL: none of them may be logged without a query either.
query I
SELECT count(*) FROM duckdb_logs_parsed('HDFS') WHERE path = '/test/rpc_abort.csv' AND query_id IS NULL;
----
0

statement ok
CALL truncate_duckdb_logs();

# --- failed calls ------------------------------------------------------------------

# A missing path: the RPC is logged as failed.
statement error
SELECT * FROM hdfs_stat('hdfs://localhost:9000/test/does_not_exist');
----
Failed to stat HDFS path 'hdfs://localhost:9000/test/does_not_exist'

query TTT
SELECT op, path, ok FROM duckdb_logs_parsed('HDFS');
----
getFileInfo	/test/does_not_exist	false

statement ok
CALL truncate_duckdb_logs();

# Nothing is logged unless the HDFS log type is enabled.
statement ok
CALL disable_logging();

query I
SELECT count(*) > 0 FROM hdfs_ls('hdfs://localhost:9000/test');
----
true

query I
SELECT count(*) FROM duckdb_logs_parsed('HDFS');
----
0
