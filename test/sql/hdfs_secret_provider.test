# name: test/sql/hdfs_secret_provider.test
# description: a persistent hdfs secret with a provider this version doesn't know is refused, not read as `config`.
# group: [sql]

# The fixture is a persistent secret as a newer version might write it: TYPE hdfs, PROVIDER future, scope
# hdfs://127.0.0.1:1/future (see test/data/hdfs_future_secret/make_fixture.py). Persistent secrets are read without
# their provider, so without the check it would have no CONFIG_DIR and connect through the Hadoop environment.
# DuckDB reads only private secret files: `make test` makes the fixture mode 0600 (git checks it out as 0644); run
# `chmod 600 test/data/hdfs_future_secret/*.duckdb_secret` first when running this file directly.

require hdfs

statement ok
SET secret_directory = 'test/data/hdfs_future_secret';

query III
SELECT name, type, provider FROM duckdb_secrets() WHERE type = 'hdfs';
----
future_provider	hdfs	future

statement error
SELECT hdfs_exists('hdfs://127.0.0.1:1/future/x');
----
HDFS secret 'future_provider' has provider 'future', which this version of the hdfs extension does not support

# URLs outside its scope are not affected.
statement ok
CREATE SECRET other (TYPE hdfs, SCOPE 'hdfs://127.0.0.1:1/elsewhere', CONFIG_DIR '/nonexistent_other');

statement error
SELECT hdfs_exists('hdfs://127.0.0.1:1/elsewhere/x');
----
config_dir '/nonexistent_other' has no core-site.xml or hdfs-site.xml
