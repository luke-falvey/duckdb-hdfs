# name: test/sql/hdfs_ez_no_provider.test
# description: Encryption-zone files without a configured key provider.
# group: [sql]

# Run via test/scripts/run_hdfs_tests.sh with a client config that has no
# hadoop.security.key.provider.path (HDFS_TEST_NO_KMS=1).

require hdfs

require-env HDFS_TEST_RUNNING

require-env HDFS_TEST_NO_KMS

# An encrypted file is an error, never ciphertext passed off as data.
statement error
SELECT * FROM read_csv('hdfs://localhost:9000/ez/java_written.csv');
----
no key provider is configured

# Files outside the zone are unaffected.
query I
SELECT count(*) FROM read_csv('hdfs://localhost:9000/test/data.csv');
----
3
