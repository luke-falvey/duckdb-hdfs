# name: test/sql/hdfs_snapshot_secret.test
# description: config_snapshot secrets: creation, use and persistence, without a cluster.
# group: [sql]

# Connecting reads the configuration before any network access, so a property that makes Connect fail early
# (hadoop.security.authentication = bogus) shows which configuration a URL used: no NameNode is needed.

require hdfs

load {TEST_DIR}/hdfs_snapshot_secret.db

statement ok
SET secret_directory = '{TEST_DIR}/hdfs_snapshot_secrets';

# --- creation -------------------------------------------------------------------------

statement ok
CREATE SECRET snap (TYPE hdfs, PROVIDER config_snapshot, SCOPE 'hdfs://127.0.0.1:1/snap',
    PROPERTIES MAP {'hadoop.security.authentication': 'bogus', 'dfs.client.socket-timeout': '30000'});

# The secret holds the properties (in key order), a format version and a fingerprint; nothing is redacted, since
# credentials are refused.
query III
SELECT name, provider, scope FROM duckdb_secrets() WHERE name = 'snap';
----
snap	config_snapshot	['hdfs://127.0.0.1:1/snap']

query I
SELECT secret_string LIKE '%format_version=1;%properties={dfs.client.socket-timeout=30000, hadoop.security.authentication=bogus}%'
FROM duckdb_secrets() WHERE name = 'snap';
----
true

query I
SELECT regexp_matches(secret_string, 'fingerprint=[0-9a-f]{64};') FROM duckdb_secrets() WHERE name = 'snap';
----
true

statement error
CREATE SECRET no_properties (TYPE hdfs, PROVIDER config_snapshot, SCOPE 'hdfs://127.0.0.1:1/x');
----
HDFS secret 'no_properties': PROVIDER config_snapshot needs PROPERTIES

statement error
CREATE SECRET empty_properties (TYPE hdfs, PROVIDER config_snapshot, PROPERTIES MAP {}::MAP(VARCHAR, VARCHAR));
----
HDFS secret 'empty_properties': PROPERTIES is empty

statement error
CREATE SECRET null_properties (TYPE hdfs, PROVIDER config_snapshot, PROPERTIES NULL::MAP(VARCHAR, VARCHAR));
----
HDFS secret 'null_properties': PROPERTIES is NULL

statement error
CREATE SECRET null_value (TYPE hdfs, PROVIDER config_snapshot, PROPERTIES MAP {'fs.defaultFS': NULL::VARCHAR});
----
HDFS secret 'null_value': property 'fs.defaultFS' in PROPERTIES is NULL

statement error
CREATE SECRET empty_key (TYPE hdfs, PROVIDER config_snapshot, PROPERTIES MAP {'': 'x'});
----
HDFS secret 'empty_key': a property name in PROPERTIES is NULL or empty

# Credentials are never stored: the secret file is not encrypted.
statement error
CREATE SECRET with_password (TYPE hdfs, PROVIDER config_snapshot,
    PROPERTIES MAP {'fs.defaultFS': 'hdfs://nn:8020', 'ssl.client.truststore.password': 'x'});
----
HDFS secret 'with_password': property 'ssl.client.truststore.password' looks like a credential

statement error
CREATE SECRET with_keytab (TYPE hdfs, PROVIDER config_snapshot,
    PROPERTIES MAP {'dfs.namenode.keytab.file': '/etc/security/nn.keytab'});
----
property 'dfs.namenode.keytab.file' looks like a credential

statement error
CREATE SECRET with_credential (TYPE hdfs, PROVIDER config_snapshot,
    PROPERTIES MAP {'hadoop.security.credential.provider.path': 'jceks://file/x.jceks'});
----
property 'hadoop.security.credential.provider.path' looks like a credential

# Principals are not credentials.
statement ok
CREATE SECRET with_principal (TYPE hdfs, PROVIDER config_snapshot, SCOPE 'hdfs://127.0.0.1:1/principal',
    PROPERTIES MAP {'dfs.namenode.kerberos.principal': 'nn/_HOST@EXAMPLE.TEST'});

statement ok
DROP SECRET with_principal;

statement error
CREATE SECRET too_many (TYPE hdfs, PROVIDER config_snapshot,
    PROPERTIES map(range(4097)::VARCHAR[], list_resize(['v'], 4097, 'v')));
----
HDFS secret 'too_many': PROPERTIES has 4097 entries, more than the 4096 allowed

statement error
CREATE SECRET too_big (TYPE hdfs, PROVIDER config_snapshot, PROPERTIES MAP {'k': repeat('v', 1048576)});
----
HDFS secret 'too_big': PROPERTIES holds 1048577 bytes, more than the 1048576 allowed

# --- use ------------------------------------------------------------------------------

# The properties are the whole configuration: no XML file is read (there is no CONFIG_DIR to check).
statement error
SELECT hdfs_exists('hdfs://127.0.0.1:1/snap/x');
----
hadoop.security.authentication=bogus is not supported

# On a Kerberos cluster the identity is the ticket's principal, so USER is still an error.
statement ok
CREATE SECRET kerberos_user (TYPE hdfs, PROVIDER config_snapshot, SCOPE 'hdfs://127.0.0.1:1/kerberos',
    PROPERTIES MAP {'hadoop.security.authentication': 'kerberos'}, USER 'someone');

statement error
SELECT hdfs_exists('hdfs://127.0.0.1:1/kerberos/x');
----
a user can't be set on a Kerberos cluster

statement ok
DROP SECRET kerberos_user;

# Snapshots with the same properties and user share a connection; another USER is another configuration.
statement ok
CALL hdfs_reset_connections();

statement ok
CREATE SECRET snap_twin (TYPE hdfs, PROVIDER config_snapshot, SCOPE 'hdfs://127.0.0.1:1/twin',
    PROPERTIES MAP {'dfs.client.socket-timeout': '30000', 'hadoop.security.authentication': 'bogus'});

statement ok
CREATE SECRET snap_user (TYPE hdfs, PROVIDER config_snapshot, SCOPE 'hdfs://127.0.0.1:1/user',
    PROPERTIES MAP {'dfs.client.socket-timeout': '30000', 'hadoop.security.authentication': 'bogus'}, USER 'other');

statement error
SELECT hdfs_exists('hdfs://127.0.0.1:1/snap/x');
----
hadoop.security.authentication=bogus is not supported

statement error
SELECT hdfs_exists('hdfs://127.0.0.1:1/twin/x');
----
hadoop.security.authentication=bogus is not supported

statement error
SELECT hdfs_exists('hdfs://127.0.0.1:1/user/x');
----
hadoop.security.authentication=bogus is not supported

query I
SELECT connections_dropped FROM hdfs_reset_connections();
----
2

statement ok
DROP SECRET snap_twin;

statement ok
DROP SECRET snap_user;

# --- persistence ----------------------------------------------------------------------

statement ok
CREATE PERSISTENT SECRET persisted (TYPE hdfs, PROVIDER config_snapshot, SCOPE 'hdfs://127.0.0.1:1/persisted',
    PROPERTIES MAP {'hadoop.security.authentication': 'persisted_bogus'});

restart

statement ok
SET secret_directory = '{TEST_DIR}/hdfs_snapshot_secrets';

query II
SELECT name, provider FROM duckdb_secrets() WHERE name = 'persisted';
----
persisted	config_snapshot

# After a restart the secret still configures its URLs, with nothing but itself.
statement error
SELECT hdfs_exists('hdfs://127.0.0.1:1/persisted/x');
----
hadoop.security.authentication=persisted_bogus is not supported

statement ok
DROP PERSISTENT SECRET persisted;
